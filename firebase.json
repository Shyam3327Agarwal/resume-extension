{
  "functions": [
    {
      "source": ".",
      "codebase": "default",
      "ignore": []
    }
  ],
  "hosting": {
    "public": "dashboard/dist/dashboard/browser",
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
